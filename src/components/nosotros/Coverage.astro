---
import { Picture } from 'astro:assets';
import port from '../../assets/img/port-aerial.jpg';
import { href } from '../../lib/url';
import { site } from '../../data/site';

const items = ["Contenedores de 20' y 40'", 'Carga general, paletizada o suelta', `Reparto con varias paradas en ${site.city}`];
---

<!-- Espejo del bloque Nosotros de la portada: foto a la izquierda, tarjeta mist a la derecha. -->
<section class="grid grid-cols-1 gap-5 md:grid-cols-2" aria-labelledby="cobertura-title">
  <div class="relative order-2 h-[280px] overflow-hidden rounded-block md:order-1 md:h-auto md:min-h-[440px]">
    <Picture
      src={port}
      alt=""
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 1280px) 610px, (min-width: 768px) 50vw, 100vw"
      formats={['avif', 'webp']}
      class="absolute inset-0 size-full object-cover"
      pictureAttributes={{ class: 'contents' }}
    />
  </div>
  <div class="order-1 flex flex-col justify-center gap-5 rounded-block bg-mist p-8 md:order-2 md:p-10 lg:p-12">
    <h2 id="cobertura-title" class="text-[34px] leading-[1.05] font-semibold tracking-h2 lg:text-[40px]">
      Del puerto a {site.city}, <span class="font-light">sin rodeos.</span>
    </h2>
    <p class="text-[17px] leading-[1.6] text-ink-muted">
      Retiramos en las terminales y bodegas portuarias y entregamos en su almacén, obra o negocio.
    </p>
    <ul class="flex flex-col gap-2.5">
      {
        items.map((t) => (
          <li class="flex items-center gap-3 text-base font-semibold">
            <span class="size-3 shrink-0 rounded-full bg-sky" aria-hidden="true" />
            {t}
          </li>
        ))
      }
    </ul>
    <a
      href={href('#servicios')}
      class="self-start rounded-pill bg-white px-[22px] py-3.5 text-[15px] font-semibold text-ink transition-opacity hover:opacity-80"
    >
      Ver servicios →
    </a>
  </div>
</section>
