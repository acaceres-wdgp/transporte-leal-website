---
import { cargoOptions } from '../data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const labelCls = 'text-xs font-semibold tracking-label text-sky-text uppercase';
const inputCls =
  'w-full min-w-0 rounded-md bg-transparent text-lg font-semibold text-ink outline-offset-4 placeholder:text-placeholder';
const cellCls = 'flex flex-col gap-1 py-3 md:py-0 lg:px-3';
---

<form
  class:list={[
    'grid grid-cols-1 rounded-bar border border-line bg-white px-6 py-4 md:grid-cols-3 md:gap-4 md:border-0 md:py-[22px] lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)_auto] lg:items-center',
    className,
  ]}
  action="#cotizar"
  aria-label="Cotización rápida"
  data-quick-quote
>
  <label class:list={[cellCls, 'border-b border-line md:border-r md:border-b-0']}>
    <span class={labelCls}>Origen</span>
    <input class={inputCls} type="text" name="origen" value="Muelle / terminal" autocomplete="off" />
  </label>
  <label class:list={[cellCls, 'border-b border-line md:border-r md:border-b-0']}>
    <span class={labelCls}>Destino</span>
    <input class={inputCls} type="text" name="destino" placeholder="¿A dónde va?" autocomplete="off" />
  </label>
  <label class={cellCls}>
    <span class={labelCls}>Carga</span>
    <span class="relative flex items-center">
      <select class:list={[inputCls, 'cursor-pointer appearance-none pr-7']} name="carga">
        {cargoOptions.map((o) => <option value={o} selected={o === "Contenedor 40'"}>{o}</option>)}
      </select>
      <svg class="pointer-events-none absolute right-1" width="12" height="8" viewBox="0 0 12 8" aria-hidden="true">
        <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
  </label>
  <button
    type="submit"
    class="mt-3 rounded-media bg-peach px-7 py-[18px] text-[17px] font-semibold whitespace-nowrap text-ink-dark transition-[filter] hover:brightness-95 md:col-span-3 md:mt-0 lg:col-span-1"
  >
    Cotizar ahora →
  </button>
</form>
